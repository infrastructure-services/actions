{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infrastructure-services.local/legacy-data-contract-v1.schema.json",
  "title": "legacy-data-contract-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "selector",
    "version",
    "targetId",
    "providerKind",
    "equality",
    "scope",
    "maximumRowsPerTable"
  ],
  "properties": {
    "contractVersion": {
      "const": 1
    },
    "selector": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "targetId": {
      "type": "string",
      "minLength": 1
    },
    "providerKind": {
      "const": "SCOPED_ROWSET_SHA256_V1"
    },
    "equality": {
      "const": "EXACT_CONTENT_HASH_V1"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targets"
      ],
      "properties": {
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema",
              "object",
              "columns"
            ],
            "properties": {
              "schema": {
                "type": "string",
                "minLength": 1
              },
              "object": {
                "type": "string",
                "minLength": 1
              },
              "columns": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "maximumRowsPerTable": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    }
  }
}

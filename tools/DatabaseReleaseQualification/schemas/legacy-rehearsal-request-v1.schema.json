{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infrastructure-services.local/legacy-rehearsal-request-v1.schema.json",
  "title": "legacy-rehearsal-request-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "artifactSelection",
    "targetId",
    "expectedPackageIdentity",
    "authorizationSelector"
  ],
  "properties": {
    "contractVersion": {
      "const": 1
    },
    "artifactSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "manifestPath",
        "expectedCommit",
        "expectedRepository"
      ],
      "properties": {
        "contractVersion": {
          "const": 1
        },
        "manifestPath": {
          "type": "string",
          "minLength": 1
        },
        "expectedCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "expectedRepository": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "host",
            "repositoryId",
            "fullName"
          ],
          "properties": {
            "host": {
              "const": "github.com"
            },
            "repositoryId": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            },
            "fullName": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "targetId": {
      "type": "string",
      "minLength": 1
    },
    "expectedPackageIdentity": {
      "type": "string",
      "pattern": "^lpqv1:[0-9a-f]{64}$"
    },
    "authorizationSelector": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "dataContractSelector": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "executionAuthorized": {
      "type": "boolean",
      "default": false
    }
  }
}
